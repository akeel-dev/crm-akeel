map "${CRM_ESQUEMA_PUBLICO}" $crm_porta_padrao {
    https 443;
    default 80;
}

map $http_host $crm_porta_publica {
    "~:(?<porta>[0-9]+)$" $porta;
    default $crm_porta_padrao;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    resolver 127.0.0.11 valid=10s ipv6=off;

    set $crm_api api:8080;
    set $crm_spa frontend:8080;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto ${CRM_ESQUEMA_PUBLICO};
    proxy_set_header X-Forwarded-Port $crm_porta_publica;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";

    location /api/ {
        proxy_pass http://$crm_api;
    }

    location /oauth2/authorization/ {
        proxy_pass http://$crm_api;
    }

    location /login/oauth2/code/ {
        proxy_pass http://$crm_api;
    }

    location = /logout {
        proxy_pass http://$crm_api;
    }

    location = /api {
        proxy_pass http://$crm_spa;
    }

    location = /oauth2/authorization {
        proxy_pass http://$crm_spa;
    }

    location = /login/oauth2/code {
        proxy_pass http://$crm_spa;
    }

    location / {
        proxy_pass http://$crm_spa;
    }
}
