# Dono: DevOps (time.yml, escrita.devops). Story 0-02.
# Configuração do ambiente local, sem segredo nenhum. O script
# deploy/local/gerar-segredos.sh copia este arquivo para .env na raiz (ignorado pelo git),
# que o docker compose lê para a interpolação.

# Nome do realm do Keycloak (spec §5.1). O compose, a exportação do realm e o
# verificar.sh leem esta variável; nenhum deles tem o nome fixo.
KEYCLOAK_REALM=crm

# Usuário do admin bootstrap do Keycloak local (a senha é segredo: deploy/local/secrets/).
KEYCLOAK_ADMIN_USER=admin

# Bucket do CRM no Garage local.
S3_BUCKET=crm-arquivos

# Portas no host (todas presas a 127.0.0.1).
POSTGRES_PORT=5432
KEYCLOAK_PORT=8180
GARAGE_S3_PORT=3900
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
